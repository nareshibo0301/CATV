# Local API against Postgres and Redis published by the dev compose file.
DATABASE_URL=postgresql://catv:change-me@localhost:5432/catv?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
PORT=3001
NODE_ENV=development

SEED_ADMIN_EMAIL=admin@catv.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ADMIN_NAME=CATV Super Admin
SEED_ADMIN_TYPE=SUPERADMIN
