# Copy to deploy/.env before `docker compose up`.
# Inside Compose, Postgres and Redis hosts are the service names.
# On the machine itself, use localhost (see apps/api/.env.example).

POSTGRES_USER=catv
POSTGRES_PASSWORD=change-me
POSTGRES_DB=catv
DATABASE_URL=postgresql://catv:change-me@postgres:5432/catv?schema=public
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# SEED_ADMIN_TYPE is DEVELOPER, SUPERADMIN, or ADMIN.
SEED_ADMIN_EMAIL=admin@catv.local
SEED_ADMIN_PASSWORD=ChangeMeNow!123
SEED_ADMIN_NAME=CATV Super Admin
SEED_ADMIN_TYPE=SUPERADMIN
RUN_SEED=true
# Optional. Falls back to JWT_ACCESS_SECRET for encryption and inbound HMAC.
# INTEGRATION_ENCRYPTION_KEY=
# INBOUND_WEBHOOK_SECRET=
SEED_DEMO=false

PORT=3001
NODE_ENV=development
